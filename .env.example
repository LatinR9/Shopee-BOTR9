# Copy to .env and fill in. NEVER commit .env

# Product to buy (full Shopee product URL)
SHOPEE_PRODUCT_URL=https://shopee.co.th/product/SHOP_ID/ITEM_ID

# Flash sale start time (ISO 8601, local or with offset)
# Example Bangkok: 2026-11-10T12:00:00+07:00
SHOPEE_SALE_START=

# How many ms early to start refreshing / clicking (default 500)
SHOPEE_PRECLICK_MS=500

# Quantity (default 1)
SHOPEE_QUANTITY=1

# Optional variant labels to click, comma-separated (e.g. "สีดำ,XL")
SHOPEE_VARIANTS=

# Login (optional if you already ran `npm run login` and have a saved session)
SHOPEE_USERNAME=
SHOPEE_PASSWORD=

# Browser
# true = no visible window; false = show browser (recommended for first runs / CAPTCHA)
SHOPEE_HEADLESS=false

# Path for persistent browser profile / saved login session
SHOPEE_USER_DATA_DIR=.auth/user-data

# After landing on checkout, auto-click place-order button?
# Keep false until you trust the flow — payment / OTP still need you.
SHOPEE_AUTO_PLACE_ORDER=false

# Max ms to keep retrying Buy Now after sale start (default 15000)
SHOPEE_CLICK_TIMEOUT_MS=15000

# Shopee base host (th / sg / my / etc.)
SHOPEE_BASE_URL=https://shopee.co.th
