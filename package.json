{
  "name": "shopee-botr9",
  "version": "1.5.0",
  "description": "Shopee Flash Sale desktop bot (Thai GUI + Playwright)",
  "main": "electron/main.cjs",
  "author": "Shopee-BOTR9",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LatinR9/Shopee-BOTR9.git"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-browsers.cjs",
    "app": "electron .",
    "start": "node src/index.js",
    "bot": "node src/index.js",
    "login": "node src/login.js",
    "dry-run": "node src/index.js --dry-run",
    "prepare:browsers": "node scripts/prepare-browsers.cjs",
    "pack:win": "npm run prepare:browsers && electron-builder --win --x64",
    "dist": "npm run pack:win"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "shopee",
    "flash-sale",
    "playwright",
    "electron",
    "bot"
  ],
  "dependencies": {
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.11",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.latinr9.shopeebotr9",
    "productName": "Shopee Flash Sale Bot",
    "copyright": "MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/playwright/**",
      "**/node_modules/playwright-core/**"
    ],
    "extraResources": [
      {
        "from": "ms-playwright",
        "to": "ms-playwright",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LatinR9",
        "repo": "Shopee-BOTR9",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ShopeeFlashSaleBot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shopee Flash Sale Bot",
      "uninstallDisplayName": "Shopee Flash Sale Bot",
      "artifactName": "ShopeeFlashSaleBot-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ShopeeFlashSaleBot-${version}-portable.${ext}"
    }
  }
}
